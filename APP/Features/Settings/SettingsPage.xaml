<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Features.Settings.SettingsPage"
             Title="Settings">

    <VerticalStackLayout Padding="24" Spacing="24"
                         VerticalOptions="Start"
                         HorizontalOptions="Fill">

        <Label Text="Settings"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Strict Mode toggle -->
        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
            <Label Text="Strict Mode"
                   FontSize="16"
                   VerticalOptions="Center"
                   Grid.Column="0" />
            <Switch IsToggled="{Binding StrictModeEnabled}"
                    Grid.Column="1"
                    VerticalOptions="Center" />
        </Grid>

        <Label Text="More settings coming soon (Vibration, Theme, etc.)"
               FontSize="14"
               TextColor="{StaticResource Gray400}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>

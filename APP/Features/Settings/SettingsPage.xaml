<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Features.Settings.SettingsPage"
             Title="Settings"
             BackgroundColor="{DynamicResource FlipSurface}">

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24"
                             Spacing="22"
                             VerticalOptions="Start"
                             HorizontalOptions="Fill"
                             MaximumWidthRequest="420">

            <Label Text="Settings"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}"
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Strict Mode"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />
                    <Label Text="Warn me if I pick up the phone during focus."
                           FontSize="14"
                           LineHeight="1.15"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Switch Grid.Column="1"
                        IsToggled="{Binding StrictModeEnabled}"
                        VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                <Label Text="Vibration"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}"
                       VerticalOptions="Center"
                       Grid.Column="0" />
                <Switch Grid.Column="1"
                        IsToggled="{Binding VibrationEnabled}"
                        VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                <Label Text="Keep Screen On"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}"
                       VerticalOptions="Center"
                       Grid.Column="0" />
                <Switch Grid.Column="1"
                        IsToggled="{Binding KeepScreenOnEnabled}"
                        VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="10" Padding="0,8,0,0">
                <Label Text="Theme"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <Border BackgroundColor="{StaticResource Gray100}"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="4">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Border Grid.Column="0"
                                BackgroundColor="{Binding TropicalOptionBackground}"
                                Stroke="{Binding TropicalOptionStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTropicalThemeTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Border WidthRequest="14"
                                        HeightRequest="14"
                                        BackgroundColor="{Binding TropicalDotColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 7"
                                        VerticalOptions="Center" />
                                <Label Text="Tropical"
                                       TextColor="{Binding TropicalOptionTextColor}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="{Binding VioletOptionBackground}"
                                Stroke="{Binding VioletOptionStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVioletThemeTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Border WidthRequest="14"
                                        HeightRequest="14"
                                        BackgroundColor="{Binding VioletDotColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 7"
                                        VerticalOptions="Center" />
                                <Label Text="Violet"
                                       TextColor="{Binding VioletOptionTextColor}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

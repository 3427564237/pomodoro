<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Features.TimeSettings.TimeSettingsPage"
             Title="Time Settings"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource FlipSurface}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="24"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="360">

            <Label Text="Time Settings"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}"
                   HorizontalOptions="Center" />

            <!-- Cycles -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Cycles"
                       FontSize="14"
                       TextColor="{DynamicResource FlipMutedText}" />
                <Entry Text="{Binding CyclesText}"
                       Keyboard="Numeric"
                       Placeholder="e.g. 2"
                       FontSize="18"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Focus minutes -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Focus (minutes)"
                       FontSize="14"
                       TextColor="{DynamicResource FlipMutedText}" />
                <Entry Text="{Binding FocusMinutesText}"
                       Keyboard="Numeric"
                       Placeholder="e.g. 25"
                       FontSize="18"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Break minutes -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Break (minutes)"
                       FontSize="14"
                       TextColor="{DynamicResource FlipMutedText}" />
                <Entry Text="{Binding BreakMinutesText}"
                       Keyboard="Numeric"
                       Placeholder="e.g. 5"
                       FontSize="18"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Error message -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="{DynamicResource FlipDanger}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />

            <!-- Save button -->
            <Button Text="Save"
                    Clicked="OnSaveClicked"
                    BackgroundColor="{DynamicResource FlipRingInner}"
                    TextColor="{DynamicResource FlipOnPrimary}"
                    CornerRadius="20"
                    Padding="24,8"
                    FontSize="16"
                    HorizontalOptions="Center"
                    WidthRequest="200" />

            <!-- Cancel button -->
            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="{DynamicResource FlipTransparent}"
                    TextColor="{DynamicResource FlipMutedText}"
                    BorderWidth="0"
                    FontSize="14"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

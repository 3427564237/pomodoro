<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Features.Main.MainPage"
             Title="FlipDoro"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource FlipSurface}">

    <Grid Padding="24,24,24,28">

        <Border WidthRequest="48"
                HeightRequest="48"
                BackgroundColor="{DynamicResource FlipTransparent}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                HorizontalOptions="End"
                VerticalOptions="Start"
                ZIndex="1">
            <Button Text="⚙"
                    FontSize="20"
                    BackgroundColor="{DynamicResource FlipTransparent}"
                    TextColor="{StaticResource Gray500}"
                    BorderWidth="0"
                    Padding="0"
                    Clicked="OnSettingsClicked" />
        </Border>

        <Grid WidthRequest="300"
              HeightRequest="300"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              TranslationY="-72">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTimerCircleTapped" />
            </Grid.GestureRecognizers>

            <Border WidthRequest="300"
                    HeightRequest="300"
                    BackgroundColor="{DynamicResource FlipRingOuter}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 150" />

            <Border WidthRequest="272"
                    HeightRequest="272"
                    BackgroundColor="{DynamicResource FlipRingInner}"
                    Stroke="{DynamicResource FlipOnPrimary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 136"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            <Label Text="{Binding TimerDisplay}"
                   TextColor="{DynamicResource FlipOnPrimary}"
                   FontSize="62"
                   FontAttributes="Bold"
                   TranslationY="-8"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding ConfigSummary}"
                   TextColor="{DynamicResource FlipRingText}"
                   FontSize="14"
                   Margin="0,118,0,0"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </Grid>

        <VerticalStackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             TranslationY="124"
                             Spacing="12">
            <Label Text="{Binding StartHintText}"
                   TextColor="{DynamicResource FlipMutedText}"
                   FontSize="15"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Button Text="▶ Start"
                    BackgroundColor="{DynamicResource FlipRingInner}"
                    TextColor="{DynamicResource FlipOnPrimary}"
                    CornerRadius="22"
                    Padding="28,10"
                    FontSize="16"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsStartButtonVisible}"
                    Clicked="OnStartClicked" />
        </VerticalStackLayout>

        <Grid ColumnDefinitions="*,*,*,*"
              Padding="0,12,0,0"
              VerticalOptions="End"
              IsVisible="False">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                <Button Text="📅" FontSize="22"
                        BackgroundColor="{DynamicResource FlipTransparent}" BorderWidth="0" Padding="4"
                        Clicked="OnCalendarClicked" />
                <Label Text="Calendar" FontSize="10"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray400}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                <Button Text="📓" FontSize="22"
                        BackgroundColor="{DynamicResource FlipTransparent}" BorderWidth="0" Padding="4"
                        Clicked="OnJournalClicked" />
                <Label Text="Journal" FontSize="10"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray400}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                <Button Text="📊" FontSize="22"
                        BackgroundColor="{DynamicResource FlipTransparent}" BorderWidth="0" Padding="4"
                        Clicked="OnStatsClicked" />
                <Label Text="Stats" FontSize="10"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray400}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                <Button Text="✅" FontSize="22"
                        BackgroundColor="{DynamicResource FlipTransparent}" BorderWidth="0" Padding="4"
                        Clicked="OnTodoClicked" />
                <Label Text="To-do" FontSize="10"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray400}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
